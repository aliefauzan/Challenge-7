{
  "name": "scamshield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that warns about scam pages and shows news-source context",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/unit/**/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.js\"",
    "test:safari": "node --test \"test/safari/**/*.test.js\"",
    "lint:rules": "node scripts/lint-rules.mjs",
    "keygen": "node scripts/keygen.mjs",
    "ruleset": "node scripts/build-ruleset.mjs",
    "feeds": "node scripts/fetch-feeds.mjs",
    "plan:status": "node scripts/plan-status.mjs",
    "icons:app": "node scripts/make-icons.mjs --app --out",
    "icons:xcode": "node scripts/make-icons.mjs --appiconset \"safari/ScamShield/Shared (App)/Assets.xcassets/AppIcon.appiconset\"",
    "safari:build": "node scripts/safari.mjs build",
    "safari:open": "node scripts/safari.mjs open",
    "safari:sim": "node scripts/safari.mjs sim"
  },
  "dependencies": {
    "tldts": "^6.1.86"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "safe-regex2": "^5.1.2"
  }
}
