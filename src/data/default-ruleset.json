  "categories": {
    "tech_support": {
      "label": "Fake tech support",
      "why": "Real security warnings never ask you to call a phone number or let a stranger control your computer."
    },
    "gift_card": {
      "label": "Gift card payment",
      "why": "No real company, bank or government office takes payment in gift cards."
    },
    "isolation": {
      "label": "Asks for secrecy",
      "why": "Scammers ask you to keep quiet so nobody you trust can warn you."
    },
    "delivery": {
      "label": "Parcel fee",
      "why": "Couriers do not ask for small fees by text message or pop-up."
    },
    "prize": {
      "label": "Prize claim",
      "why": "If you have to pay or share details to get a prize, it is not a prize."
    },
    "government": {
      "label": "Government threat",
      "why": "Government offices send letters. They do not threaten arrest by phone or web page."
    },
    "account": {
      "label": "Account threat",
      "why": "Banks and shops do not lock your account and then ask you to log in through a link."
    },
    "investment": {
      "label": "Too-good investment",
      "why": "Nobody can promise guaranteed profits. Promises like this are a common way to steal savings."
    },
    "payment_method": {
      "label": "Unusual payment",
      "why": "Requests to pay with crypto, wire transfers or cash machines are hard to reverse. Scammers like them for that reason."
    },
    "refund": {
      "label": "Overpayment refund",
      "why": "The 'we refunded too much, please send it back' story is a trick. The first payment is never real."
    },
    "urgency": {
      "label": "Pressure to act now",
      "why": "Scammers set short deadlines so you act before you can think or ask someone."
    },
    "safe_account": {
      "label": "\"Safe account\" story",
      "why": "Your bank will never ask you to move your money to keep it safe. Anyone who does is stealing it."
    },
    "family_emergency": {
      "label": "Family emergency",
      "why": "Scammers pretend to be a relative in trouble. Hang up and call that person on the number you already have."
    },
    "subscription": {
      "label": "Fake renewal charge",
      "why": "Fake invoices want you to call them. The number reaches the scammer, not the company."
    },
    "recovery": {
      "label": "Money recovery offer",
      "why": "People who lost money get offers to win it back for a fee. Those offers are a second scam."
    },
    "qr_payment": {
      "label": "QR code trick",
      "why": "You never need to scan a code to receive money. Scanning can send your money away or open a fake page."
    },
    "utility": {
      "label": "Utility cut-off threat",
      "why": "Power, gas and water companies send written notices first. They do not demand instant payment to stop a cut-off."
    }
  },
