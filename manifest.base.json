{
  "manifest_version": 3,
  "name": "ScamShield",
  "description": "Warns you about scam pages before you lose money or data.",
  "version": "0.0.0",
  "action": {
    "default_title": "ScamShield",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "alarms", "declarativeNetRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
